# Build openpak_ca.sprx with PSL1GHT (https://github.com/ps3dev/PSL1GHT, ps3toolchain).
# Needs PSL1GHT installed and PS3DEV/PSL1GHT set, plus openpak_ca_patch.h generated by
# ../tools/stage.sh. No binary is committed; run this locally or in CI (see ../.github/workflows).
#
#   (from the repo root)  make stage        # fetch CA, write dist/ + plugin/openpak_ca_patch.h
#   (here)                make              # -> openpak_ca.sprx
#
# A VSH plugin is an sprx with a resident module_start. ppu_toolchain builds the PRX; sprxlinker
# packs it. If your PSL1GHT lacks sprxlinker, the .prx it produces is already loadable by Cobra as
# a VSH plugin -- rename it openpak_ca.sprx.

ifndef PS3DEV
$(error PS3DEV is not set -- install ps3toolchain/PSL1GHT first)
endif
ifndef PSL1GHT
PSL1GHT := $(PS3DEV)
endif

CC       := $(PS3DEV)/ppu/bin/ppu-gcc
SPRX     := $(PS3DEV)/bin/sprxlinker

TARGET   := openpak_ca
SRC      := openpak_ca.c
GEN      := openpak_ca_patch.h

CFLAGS   := -O2 -Wall -mcpu=cell -fpic -ffreestanding -I$(PSL1GHT)/ppu/include
LDFLAGS  := -nostartfiles -Wl,-q -fpic -mprx -L$(PSL1GHT)/ppu/lib

all: $(TARGET).sprx

$(GEN):
	@echo "run 'make stage' from the repo root first to generate $(GEN)"; exit 1

$(TARGET).elf: $(SRC) $(GEN)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(SRC)

$(TARGET).prx: $(TARGET).elf
	$(SPRX) $< $@

$(TARGET).sprx: $(TARGET).prx
	cp $< $@

clean:
	rm -f $(TARGET).elf $(TARGET).prx $(TARGET).sprx

.PHONY: all clean
